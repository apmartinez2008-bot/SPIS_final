###################################################################################
## Define Main Variables
###################################################################################
fen_line = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR'
board = chess.Board(fen=fen_line)
dir_path = os.path.dirname(os.path.realpath(__file__)) + "/numpy_saved"

number_to_position_map = []
map_position = {}
last_move = ""

###################################################################################
## Setup Directories & Mappings
###################################################################################
print("Enter Session/Run Name: ")
code = str(input())
dir_path += "/" + code
if not os.path.exists(dir_path):
    os.makedirs(dir_path)

def map_function():
    x, y = 0, 0
    for i in "87654321":
        for j in "abcdefgh":
            map_position[j + i] = [x, y]
            y = (y + 1) % 8
        x = (x + 1) % 8
    np.savez(dir_path + "/map_position.npz", **map_position)

def map_function_for_number_2_position():
    str1 = "87654321"
    str2 = "abcdefgh"
    for i in range(8):
        temp = []
        for j in range(8):
            temp.append(str(str2[j] + str1[i]))
        number_to_position_map.append(temp)

map_function()
map_function_for_number_2_position()

###################################################################################
## Helper Functions
###################################################################################
def fen2board(fen_line):
    chess_board = []
    current_player_bool_position = []
    for row in fen_line.split(' ')[0].split('/'):
        bool_row = []
        chess_row = []
        for cell in list(row):
            if cell.isnumeric():
                for i in range(int(cell)):
                    chess_row.append(str(1))
                    bool_row.append(0)
            else:
                chess_row.append(cell)
                bool_row.append(1)
        chess_board.append(chess_row)
        current_player_bool_position.append(bool_row)
    return np.array(chess_board), np.array(current_player_bool_position)

def fen2board_2(fen_line):
    chess_board = []
    for row in fen_line.split(' ')[0].split('/'):
        chess_row = []
        for cell in list(row):
            if cell.isnumeric():
                for i in range(int(cell)):
                    chess_row.append(str(' '))
            else:
                chess_row.append(cell)
        chess_board.append(chess_row)
    return np.array(chess_board)

def draw_predefined_grid(frame, square_dict):
    """Draws each square polygon on the camera frame."""
    for (row, col), corners in square_dict.items():
        pts = np.array(corners, np.int32).reshape((-1, 1, 2))
        cv2.polylines(frame, [pts], isClosed=True, color=(0, 255, 0), thickness=1)

def show_game(game_img, board, player_move):
    side_img = np.zeros((FRAME_HEIGHT, 400, 3), dtype=np.uint8)
    game_img = np.concatenate((game_img, side_img), axis=1)

    # Draw the custom polygon grid onto the game board frame
    draw_predefined_grid(game_img, BOARD_SQUARES)

    cv2.putText(game_img, "Player Turn : ", (650, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
    if board.turn:
        cv2.putText(game_img, "White", (810, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(game_img, "Press 'W' after White moves", (650, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    else:
        cv2.putText(game_img, "Black", (810, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(game_img, "Press 'Q' after Black moves", (650, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

    chess_board = fen2board_2(str(board.fen()))
    padding_col = 0
    for i in chess_board:
        padding_row = 0
        for j in i:
            color = (0, 255, 0) if str(j).isupper() else (255, 0, 0)
            cv2.putText(game_img, "{}".format(j), (padding_row + 670, padding_col + 110), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
            padding_row += 30
        padding_col += 30

    if len(player_move) != 0:
        cv2.putText(game_img, "Last Move : ", (650, 380), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
        cv2.putText(game_img, "{}".format(player_move), (770, 380), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.putText(game_img, "Check : ", (650, 420), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
    cv2.putText(game_img, "{}".format(board.is_check()), (750, 420), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.putText(game_img, "Checkmate : ", (650, 450), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
    cv2.putText(game_img, "{}".format(board.is_checkmate()), (780, 450), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.imshow("Chess Vision Tracker", game_img)

def process_human_turn(player_name, key_trigger):
    global board, last_move
    chess_board, bool_position = fen2board(board.fen())

    # Pre-move snapshot
    img_1 = capture_frame()
    show_game(img_1, board, last_move)

    print(f"\n{player_name}'s Turn! Move piece on board, then press '{key_trigger}'...")
    while True:
        if cv2.waitKey(1) == ord(key_trigger):
            break

    # Post-move snapshot
    img_2 = capture_frame()

    move_word, game_img, flag = find_current_past_position(
        img_1, img_2, BOARD_SQUARES, bool_position, board.fen(), chess_board, number_to_position_map, map_position
    )

    if flag:
        move = chess.Move.from_uci(str(move_word))
        if move in board.legal_moves:
            board.push(move)
            last_move = str(move_word)
            show_game(game_img, board, last_move)
            print(f"{player_name} moved: {move_word}")
        else:
            print("Illegal Move Detected! Reset physical pieces...")
            show_game(img_2, board, last_move)
    else:
        print("No valid move detected. Try again.")
        show_game(game_img, board, last_move)

###################################################################################
## Preview Alignment Check
###################################################################################
print("Displaying grid overlay preview. Align board and press 'c' to continue...")
while True:
    frame = capture_frame()
    draw_predefined_grid(frame, BOARD_SQUARES)
    cv2.imshow("Align Physical Board with Grid", frame)
    if cv2.waitKey(1) & 0xFF == ord('c'):
        cv2.destroyAllWindows()
        break

###################################################################################
## Main 2-Player Game Loop
###################################################################################
try:
    while not board.is_checkmate():
        if board.turn:
            process_human_turn("White", 'w')
        else:
            process_human_turn("Black", 'q')

    print("Game Over - Checkmate!")
    img = capture_frame()
    show_game(img, board, last_move)
    cv2.waitKey(0)

finally:
    picam2.stop()
    cv2.destroyAllWindows()
    print("Program Exited.")
