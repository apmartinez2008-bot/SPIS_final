FRAME_WIDTH, FRAME_HEIGHT = 640, 480

picam2 = Picamera2()
camera_config = picam2.create_video_configuration(
    main={"format": "BGR888", "size": (FRAME_WIDTH, FRAME_HEIGHT)}
)
picam2.configure(camera_config)
picam2.start()

def capture_frame():
    return picam2.capture_array()

