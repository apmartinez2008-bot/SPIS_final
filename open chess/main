###################################################################################
## Define Main Variables
###################################################################################
board = chess.Board()
dir_path = os.path.dirname(os.path.realpath(__file__)) + "/numpy_saved"

number_to_position_map = []
map_position = {}
last_move = ""

###################################################################################
## Setup Directories & Mappings
###################################################################################
print("Enter Session/Run Name: ")
code = str(input())
dir_path += "/" + code
if not os.path.exists(dir_path):
    os.makedirs(dir_path)

def map_function():
    x, y = 0, 0
    # Files map across rows, Ranks map across columns
    for i in "abcdefgh":
        for j in "87654321":
            map_position[i + j] = [x, y]
            y = (y + 1) % 8
        x = (x + 1) % 8
    np.savez(dir_path + "/map_position.npz", **map_position)

def map_function_for_number_2_position():
    files = "abcdefgh"
    ranks = "87654321"
    for i in range(8):
        temp = []
        for j in range(8):
            # Row i -> files[i], Column j -> ranks[j]
            temp.append(str(files[i] + ranks[j]))
        number_to_position_map.append(temp)

map_function()
map_function_for_number_2_position()

###################################################################################
## Helper Functions
###################################################################################
def fen2board(fen_line):
    chess_board = []
    current_player_bool_position = []
    for row in fen_line.split(' ')[0].split('/'):
        bool_row = []
        chess_row = []
        for cell in list(row):
            if cell.isnumeric():
                for i in range(int(cell)):
                    chess_row.append(str(1))
                    bool_row.append(0)
            else:
                chess_row.append(cell)
                bool_row.append(1)
        chess_board.append(chess_row)
        current_player_bool_position.append(bool_row)
    return np.array(chess_board), np.array(current_player_bool_position)

def fen2board_2(fen_line):
    chess_board = []
    for row in fen_line.split(' ')[0].split('/'):
        chess_row = []
        for cell in list(row):
            if cell.isnumeric():
                for i in range(int(cell)):
                    chess_row.append(str(' '))
            else:
                chess_row.append(cell)
        chess_board.append(chess_row)
    return np.array(chess_board)

def draw_predefined_grid(frame, square_dict):
    """Draws each square polygon on the camera frame."""
    for (row, col), corners in square_dict.items():
        pts = np.array(corners, np.int32).reshape((-1, 1, 2))
        cv2.polylines(frame, [pts], isClosed=True, color=(0, 255, 0), thickness=1)

def show_game(game_img, board, player_move):
    side_img = np.zeros((FRAME_HEIGHT, 400, 3), dtype=np.uint8)
    game_img = np.concatenate((game_img, side_img), axis=1)

    # Draw the custom polygon grid onto the game board frame
    draw_predefined_grid(game_img, BOARD_SQUARES)

    cv2.putText(game_img, "Player Turn : ", (650, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
    if board.turn:
        cv2.putText(game_img, "White", (810, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(game_img, "Press 'W' after White moves", (650, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    else:
        cv2.putText(game_img, "Black", (810, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(game_img, "Press 'Q' after Black moves", (650, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

    chess_board = fen2board_2(str(board.fen()))
    padding_col = 0
    for i in chess_board:
        padding_row = 0
        for j in i:
            color = (0, 255, 0) if str(j).isupper() else (255, 0, 0)
            cv2.putText(game_img, "{}".format(j), (padding_row + 670, padding_col + 110), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
            padding_row += 30
        padding_col += 30

    if len(player_move) != 0:
        cv2.putText(game_img, "Last Move : ", (650, 380), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
        cv2.putText(game_img, "{}".format(player_move), (770, 380), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.putText(game_img, "Check : ", (650, 420), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
    cv2.putText(game_img, "{}".format(board.is_check()), (750, 420), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.putText(game_img, "Checkmate : ", (650, 450), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
    cv2.putText(game_img, "{}".format(board.is_checkmate()), (780, 450), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)

    cv2.imshow("Chess Vision Tracker", game_img)

def process_human_turn(player_name, key_trigger):
    global board, last_move
    chess_board, bool_position = fen2board(board.fen())

    # Pre-move snapshot
    img_1 = capture_frame()
    show_game(img_1, board, last_move)

    print(f"\n{player_name}'s Turn! Move piece on board, then press '{key_trigger}' (or 'x' to surrender)...")
    
    surrendered = False
    undo_requested = False

    while True:
        key = cv2.waitKey(1) & 0xFF
        if key == ord(key_trigger):
            break
        elif key == ord('x') or key == ord('X'):
            print(f"\n{player_name} has surrendered!")
            surrendered = True
            break
        elif key == ord('b') or key == ord('B'):
            if len(board.move_stack) > 0:
                undo_requested = True
                break
            else:
                print("\nCannot undo: No moves have been played yet!")

    if surrendered:
        return "surrender"

    if undo_requested:
        undone_move = board.pop()
        # Update last_move display string to reflect the move prior to the undone one
        last_move = str(board.peek()) if len(board.move_stack) > 0 else ""
        print(f"\n[UNDO] Undid last move: {undone_move}")
        show_game(capture_frame(), board, last_move)
        return "undo"

    # Brief delay to allow hand shadows and camera shake to dissipate
    time.sleep(0.3)

    # Post-move snapshot
    img_2 = capture_frame()

    move_word, game_img, flag = find_current_past_position(
        img_1, img_2, BOARD_SQUARES, bool_position, board.fen(), chess_board, number_to_position_map, map_position
    )

    if flag:
        raw_word = str(move_word).replace(" ", "").strip()

        # 1. Castling Intercept Logic
        is_white_ks = "e1" in raw_word and "g1" in raw_word
        is_white_qs = "e1" in raw_word and "c1" in raw_word
        is_black_ks = "e8" in raw_word and "g8" in raw_word
        is_black_qs = "e8" in raw_word and "c8" in raw_word

        castle_move = None
        if board.turn == chess.WHITE:
            if is_white_ks: castle_move = chess.Move.from_uci("e1g1")
            elif is_white_qs: castle_move = chess.Move.from_uci("e1c1")
        else:
            if is_black_ks: castle_move = chess.Move.from_uci("e8g8")
            elif is_black_qs: castle_move = chess.Move.from_uci("e8c8")

        # Execute castling if matched & legal
        if castle_move and castle_move in board.legal_moves:
            board.push(castle_move)
            last_move = str(castle_move)
            show_game(game_img, board, last_move)
            print(f"Detected Castling! {player_name} moved: {castle_move}")
            return

        # 2. Filter Candidate Moves Against Valid Legal Moves
        matched_move = None
        best_extra_count = None

        # Parse all detected square strings into a clean set (e.g. {'f3', 'g2', 'g1'})
        detected_squares = set(raw_word[i:i+2] for i in range(0, len(raw_word), 2))

        for legal_move in board.legal_moves:
            uci_str = legal_move.uci()
            from_sq = uci_str[:2]
            to_sq = uci_str[2:4]

            # Skip non-relocations
            if legal_move.from_square == legal_move.to_square:
                continue

            # Verify both start and end squares were flagged as changed by the camera
            if from_sq in detected_squares and to_sq in detected_squares:

                # Any detected squares beyond from/to are noise: hand shadows, camera
                # shake, or a piece getting bumped and set back down. Rather than
                # accepting the first legal move that fits (which can be wrong if a
                # bump happens to overlap another move's squares), score every
                # candidate by how much unexplained noise it leaves behind and keep
                # the cleanest match.
                extra_squares = detected_squares - {from_sq, to_sq}
                extra_count = len(extra_squares)

                if best_extra_count is None or extra_count < best_extra_count:
                    matched_move = legal_move
                    best_extra_count = extra_count

                    # Can't do better than zero leftover squares - stop early
                    if best_extra_count == 0:
                        break

        if matched_move:
            board.push(matched_move)
            last_move = str(matched_move)
            show_game(game_img, board, last_move)
            print(f"{player_name} moved: {matched_move}")

        else:
            print(f"No valid piece relocation detected (or illegal move: '{raw_word}').")
            show_game(img_2, board, last_move)
    else:
        print("No move detected. Please try again.")
        show_game(img_1, board, last_move)

###################################################################################
## Preview Alignment Check
###################################################################################
print("Displaying grid overlay preview. Align board and press 'c' to continue...")
while True:
    frame = capture_frame()
    draw_predefined_grid(frame, BOARD_SQUARES)
    cv2.imshow("Align Physical Board with Grid", frame)
    if cv2.waitKey(1) & 0xFF == ord('c'):
        cv2.destroyAllWindows()
        break

###################################################################################
## Main 2-Player Game Loop
###################################################################################
surrender_player = None

try:
    while not board.is_checkmate():
        if board.turn:
            result = process_human_turn("White", 'w')
            if result == "surrender":
                surrender_player = "White"
                break
        else:
            result = process_human_turn("Black", 'q')
            if result == "surrender":
                surrender_player = "Black"
                break

    if surrender_player:
        print(f"Game Over - {surrender_player} Surrendered!")
    else:
        print("Game Over - Checkmate!")
    
    # 1. Create a PGN game object from the python-chess board stack
    pgn_game = chess.pgn.Game.from_board(board)
    
    # 2. Add standard PGN Headers
    pgn_game.headers["Event"] = f"Vision Chess Session {code}"
    pgn_game.headers["Site"] = "Raspberry Pi Tracker"
    pgn_game.headers["Date"] = time.strftime("%Y.%m.%d")
    pgn_game.headers["White"] = "White Player"
    pgn_game.headers["Black"] = "Black Player"
    
    # Set game result
    if surrender_player:
        pgn_game.headers["Result"] = "0-1" if surrender_player == "White" else "1-0"
    elif board.is_checkmate():
        pgn_game.headers["Result"] = "1-0" if not board.turn else "0-1"
    else:
        pgn_game.headers["Result"] = "*"

    # 3. Export to .pgn file inside your session directory
    pgn_path = os.path.join(dir_path, f"game_{code}.pgn")
    with open(pgn_path, "w") as pgn_file:
        exporter = chess.pgn.FileExporter(pgn_file)
        pgn_game.accept(exporter)

    print(f"PGN successfully saved to: {pgn_path}")
    
    # Print direct Chessigma instructions and URL
    print("\n" + "="*50)
    print("GAME ANALYSIS LINK:")
    print("https://chessigma.com/")
    print("\nCopy and paste the PGN below into Chessigma:")
    print("-" * 50)
    print(str(pgn_game))
    print("="*50 + "\n")

    img = capture_frame()
    show_game(img, board, last_move)
    cv2.waitKey(0)

finally:
    picam2.stop()
    cv2.destroyAllWindows()
    print("Program Exited.")
